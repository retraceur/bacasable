{
	"name": "@retraceur/bacasable",
	"version": "1.0.0-beta1",
	"description": "A Node.js tool to instantly build your local Retraceur development environment",
	"type": "module",
	"bin": {
		"bacasable": "./build/main.js"
	},
	"main": "./build/index.js",
	"exports": {
		".": "./build/index.js"
	},
	"files": [
		"build/main.js",
		"build/index.js",
		"README.md",
		"LICENSE.md",
		"CREDITS.md",
		"CHANGELOG.md"
	],
	"scripts": {
		"build": "node esbuild.mjs",
		"dev": "node esbuild.mjs --watch",
		"prepublishOnly": "npm run build"
	},
	"dependencies": {
		"@wp-playground/cli": "^3.1.13",
		"commander": "^11.0.0",
		"follow-redirects": "^1.15.0",
		"fs-extra": "^11.0.0",
		"tslib": "^2.8.1",
		"yauzl": "^3.4.0"
	},
	"devDependencies": {
		"@types/follow-redirects": "^1.14.0",
		"@types/fs-extra": "^11.0.0",
		"@types/node": "^22.0.0",
		"@types/yauzl": "^3.4.0",
		"esbuild": "^0.20.0",
		"typescript": "^5.0.0"
	},
	"engines": {
		"node": ">=22.0.0"
	},
	"allowScripts": {
		"esbuild@0.20.2": true,
		"fs-ext-extra-prebuilt@2.2.7": true
	}
}
